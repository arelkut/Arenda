<Window x:Class="ArendaDesktop.Windows.MainCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Недвижимость.РФ — Каталог"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка (белая как в Figma) -->
        <Border Grid.Row="0" Background="White" Padding="24,14"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Недвижимость.РФ" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="UserEmailText" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button x:Name="MyPropertiesButton" Content="Мои объявления"
                            Style="{StaticResource SecondaryButton}" Padding="16,8"
                            Click="MyPropertiesButton_Click" Margin="0,0,8,0"
                            Visibility="Collapsed" />
                    <Button x:Name="AdminButton" Content="Админ панель"
                            Style="{StaticResource SecondaryButton}" Padding="16,8"
                            Click="AdminButton_Click" Margin="0,0,8,0"
                            Visibility="Collapsed" />
                    <Button Content="Выйти" Style="{StaticResource PrimaryButton}"
                            Padding="20,8" Click="LogoutButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Фильтры (как в Figma) -->
        <Border Grid.Row="1" Background="White" Padding="24,16" Margin="0,0,0,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Тип недвижимости" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="TypeFilter" Style="{StaticResource ModernComboBox}" Height="38">
                            <ComboBoxItem Content="Все типы" IsSelected="True" />
                            <ComboBoxItem Content="Квартира" />
                            <ComboBoxItem Content="Студия" />
                            <ComboBoxItem Content="Дом" />
                            <ComboBoxItem Content="Комната" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                        <TextBlock Text="Город" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CityFilter" Style="{StaticResource ModernTextBox}" Height="38" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="8,0,8,0">
                        <TextBlock Text="Поиск" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SearchBox" Style="{StaticResource ModernTextBox}" Height="38" />
                    </StackPanel>
                    <Button Grid.Column="3" Content="Найти" Style="{StaticResource PrimaryButton}"
                            Padding="24,8" VerticalAlignment="Bottom" Click="SearchButton_Click" Height="38" />
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Комнат" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="RoomsFilter" Style="{StaticResource ModernComboBox}" Height="38">
                            <ComboBoxItem Content="Любое" IsSelected="True" />
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                            <ComboBoxItem Content="4+" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                        <TextBlock Text="Цена от" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="MinPriceFilter" Style="{StaticResource ModernTextBox}" Height="38" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="8,0,8,0">
                        <TextBlock Text="Цена до" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="MaxPriceFilter" Style="{StaticResource ModernTextBox}" Height="38" />
                    </StackPanel>
                    <Button Grid.Column="3" Content="Сбросить" Style="{StaticResource SecondaryButton}"
                            Padding="20,8" VerticalAlignment="Bottom" Click="ResetFilters_Click" Height="38" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Контент -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,16">
                <Grid Margin="0,0,0,16">
                    <TextBlock x:Name="TotalText" Text="Найдено объектов: 0"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Grid>
                <TextBlock x:Name="LoadingText" Text="Загрузка..."
                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,40,0,0"
                           Visibility="Collapsed" />
                <WrapPanel x:Name="PropertiesPanel" />
            </StackPanel>
        </ScrollViewer>

        <!-- Пагинация -->
        <Border Grid.Row="3" Background="White" Padding="24,12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="PrevButton" Content="← Назад"
                        Style="{StaticResource SecondaryButton}"
                        Padding="16,8" Click="PrevButton_Click"
                        IsEnabled="False" Margin="0,0,12,0" />
                <TextBlock x:Name="PageText" Text="Страница 1"
                           FontSize="14" VerticalAlignment="Center" Margin="8,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Button x:Name="NextButton" Content="Далее →"
                        Style="{StaticResource SecondaryButton}"
                        Padding="16,8" Click="NextButton_Click"
                        Margin="12,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
