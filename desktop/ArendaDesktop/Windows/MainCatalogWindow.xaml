<Window x:Class="ArendaDesktop.Windows.MainCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Недвижимость.РФ — Каталог"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="24,14">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="🏠" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Недвижимость.РФ" FontSize="18" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="UserEmailText" FontSize="13" Foreground="#CBD5E1"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button x:Name="ProfileButton" Content="Мои объявления"
                            Style="{StaticResource SecondaryButton}"
                            Foreground="White" Background="Transparent"
                            Padding="12,6" FontSize="13"
                            Click="ProfileButton_Click"
                            Visibility="Collapsed" Margin="0,0,8,0" />
                    <Button x:Name="AdminButton" Content="Админ панель"
                            Style="{StaticResource SecondaryButton}"
                            Foreground="White" Background="Transparent"
                            Padding="12,6" FontSize="13"
                            Click="AdminButton_Click"
                            Visibility="Collapsed" Margin="0,0,8,0" />
                    <Button Content="Выход" Style="{StaticResource SecondaryButton}"
                            Foreground="White" Background="Transparent"
                            Padding="12,6" FontSize="13"
                            Click="LogoutButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Заголовок -->
        <StackPanel Grid.Row="1" Margin="24,20,24,0">
            <TextBlock Text="Каталог недвижимости" FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock x:Name="TotalText" FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Поиск и фильтры -->
        <Border Grid.Row="2" Margin="24,16,24,0" Background="White" CornerRadius="12" Padding="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="Black" />
            </Border.Effect>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Style="{StaticResource ModernTextBox}"
                             Grid.Column="0" Margin="0,0,8,0"
                             KeyDown="SearchBox_KeyDown" />
                    <Button Content="⚙ Фильтры" Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Padding="16,10" FontSize="13" Margin="0,0,8,0"
                            Click="ToggleFilters_Click" />
                    <Button Content="Найти" Grid.Column="2"
                            Style="{StaticResource PrimaryButton}"
                            Padding="24,10" FontSize="13"
                            Click="SearchButton_Click" />
                </Grid>

                <!-- Панель фильтров -->
                <Border x:Name="FiltersPanel" Visibility="Collapsed" Margin="0,12,0,0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        Padding="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Город" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="CityFilter" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Тип" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="TypeFilter" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="Все" IsSelected="True" />
                                <ComboBoxItem Content="Квартира" />
                                <ComboBoxItem Content="Студия" />
                                <ComboBoxItem Content="Дом" />
                                <ComboBoxItem Content="Коммерческая" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Комнат" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="RoomsFilter" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="Все" IsSelected="True" />
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="4+" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                            <TextBlock Text="Цена до (₽)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="MaxPriceFilter" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>
                        <Button Content="Сбросить" Grid.Column="4"
                                Style="{StaticResource SecondaryButton}"
                                Padding="16,10" FontSize="13"
                                VerticalAlignment="Bottom"
                                Click="ResetFilters_Click" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Список объявлений -->
        <ScrollViewer Grid.Row="3" Margin="24,16,24,0" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="PropertiesPanel" />
        </ScrollViewer>

        <!-- Загрузка -->
        <TextBlock x:Name="LoadingText" Grid.Row="3" Text="Загрузка..."
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                   Visibility="Collapsed" />

        <!-- Пагинация -->
        <Border Grid.Row="4" Padding="24,12" Background="White"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="PrevButton" Content="← Назад"
                        Style="{StaticResource SecondaryButton}"
                        Padding="16,8" FontSize="13" Margin="0,0,8,0"
                        Click="PrevPage_Click" />
                <TextBlock x:Name="PageText" VerticalAlignment="Center"
                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="8,0" />
                <Button x:Name="NextButton" Content="Далее →"
                        Style="{StaticResource SecondaryButton}"
                        Padding="16,8" FontSize="13" Margin="8,0,0,0"
                        Click="NextPage_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
