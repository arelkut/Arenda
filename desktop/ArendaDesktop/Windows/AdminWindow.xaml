<Window x:Class="ArendaDesktop.Windows.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Недвижимость.РФ — Админ панель"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Боковая панель -->
        <Border Grid.Column="0" Background="White"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Профиль -->
                <Border DockPanel.Dock="Top" Padding="20,24,20,20"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="20"
                                    Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                                <TextBlock x:Name="AvatarText" FontSize="16" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="AdminNameText" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <Border Background="#DCFCE7" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left">
                                    <TextBlock Text="Админ" FontSize="11" Foreground="#16A34A" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <Button Content="← На главную" Margin="0,16,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,6" FontSize="12"
                                HorizontalAlignment="Left"
                                Click="HomeButton_Click" />
                    </StackPanel>
                </Border>

                <!-- Навигация -->
                <StackPanel Margin="12,12,12,0">
                    <Button x:Name="NavUsers" Content="👥 Управление пользователями"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,4" Padding="12,10"
                            Click="NavUsers_Click"
                            Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="NavProperties" Content="🏢 Управление объявлениями"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,4" Padding="12,10"
                            Click="NavProperties_Click"
                            Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="NavModeration" Content="📋 Модерация"
                            HorizontalContentAlignment="Left"
                            Margin="0,0,0,4" Padding="12,10"
                            Click="NavModeration_Click"
                            Style="{StaticResource SecondaryButton}" />
                </StackPanel>

                <!-- Выход -->
                <Button Content="Выход" DockPanel.Dock="Bottom"
                        Style="{StaticResource DangerButton}"
                        Padding="12,8" Margin="12,0,12,16"
                        Click="LogoutButton_Click" />
            </DockPanel>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="24,24,24,0">
                <TextBlock x:Name="PageTitle" Text="Управление пользователями"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock x:Name="PageSubtitle" Text="Управление зарегистрированными пользователями"
                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- Статистика -->
            <WrapPanel Grid.Row="1" Margin="24,16,24,0">
                <Border x:Name="StatUsers" Background="White" CornerRadius="12" Padding="20,14"
                        Margin="0,0,12,0" MinWidth="180">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06" Color="Black" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👥" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="Пользователей" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock x:Name="UsersCountText" Text="0" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="StatProperties" Background="White" CornerRadius="12" Padding="20,14"
                        Margin="0,0,12,0" MinWidth="180">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06" Color="Black" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏢" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="Объявлений" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock x:Name="PropertiesCountText" Text="0" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="StatPending" Background="White" CornerRadius="12" Padding="20,14"
                        MinWidth="180">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06" Color="Black" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏳" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="На модерации" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock x:Name="PendingCountText" Text="0" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource WarningBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Поиск -->
            <Border Grid.Row="2" Margin="24,16,24,0" Background="White" CornerRadius="8" Padding="12">
                <TextBox x:Name="SearchBox" Style="{StaticResource ModernTextBox}"
                         KeyDown="SearchBox_KeyDown" />
            </Border>

            <!-- Сообщение -->
            <Border x:Name="MessageBorder" Grid.Row="3" Margin="24,12,24,0"
                    CornerRadius="8" Padding="12,8" Visibility="Collapsed"
                    VerticalAlignment="Top" HorizontalAlignment="Stretch" MaxHeight="40">
                <TextBlock x:Name="MessageText" FontSize="13" Foreground="White" />
            </Border>

            <!-- Контент -->
            <ScrollViewer Grid.Row="3" Margin="24,12,24,24" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContentPanel" />
            </ScrollViewer>

            <!-- Загрузка -->
            <TextBlock x:Name="LoadingText" Grid.Row="3" Text="Загрузка..."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
