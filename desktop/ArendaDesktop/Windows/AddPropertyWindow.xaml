<Window x:Class="ArendaDesktop.Windows.AddPropertyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить объявление"
        Width="800" Height="750"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="White" Padding="24,14"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock Text="Недвижимость.РФ" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,24">
                <TextBlock Text="Добавить объявление" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <TextBlock Text="Заполните информацию о вашей недвижимости для аренды"
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,24" />

                <!-- Ошибка -->
                <Border x:Name="ErrorBorder" Background="#FEF2F2" CornerRadius="8"
                        Padding="12,8" Margin="0,0,0,16" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="#DC2626" FontSize="13"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Основная информация + Местоположение в 2 колонки -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Основная информация -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Основная информация" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />
                            <TextBlock Text="Тип недвижимости" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="PropertyTypeBox" Style="{StaticResource ModernComboBox}" Margin="0,0,0,12">
                                <ComboBoxItem Content="Квартира" IsSelected="True" />
                                <ComboBoxItem Content="Студия" />
                                <ComboBoxItem Content="Дом" />
                                <ComboBoxItem Content="Комната" />
                            </ComboBox>
                            <TextBlock Text="Название объявления *" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TitleBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12" />
                            <TextBlock Text="Описание" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DescriptionBox" Style="{StaticResource ModernTextBox}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>

                    <!-- Местоположение -->
                    <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Местоположение" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />
                            <TextBlock Text="Адрес *" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="AddressBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Город *" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CityBox" Style="{StaticResource ModernTextBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Район" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="DistrictBox" Style="{StaticResource ModernTextBox}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Характеристики + Стоимость в 2 колонки -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Характеристики -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Характеристики" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Количество комнат" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="RoomsBox" Style="{StaticResource ModernTextBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Площадь (м²) *" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="AreaBox" Style="{StaticResource ModernTextBox}" />
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Этаж" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="FloorBox" Style="{StaticResource ModernTextBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Этажей в доме" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="TotalFloorsBox" Style="{StaticResource ModernTextBox}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Стоимость -->
                    <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Стоимость" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />
                            <TextBlock Text="Цена за месяц (₽) *" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="PriceBox" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="SubmitButton" Content="Опубликовать объявление"
                            Style="{StaticResource PrimaryButton}"
                            Padding="24,12" Click="SubmitButton_Click" Margin="0,0,12,0" />
                    <Button Content="Отмена" Style="{StaticResource SecondaryButton}"
                            Padding="24,12" Click="CancelButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
