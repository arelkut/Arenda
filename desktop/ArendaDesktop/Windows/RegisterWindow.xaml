<Window x:Class="ArendaDesktop.Windows.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Недвижимость.РФ — Регистрация"
        Width="480" Height="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="White" CornerRadius="16" Padding="40"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="400" Margin="0,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.08" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <!-- Логотип -->
                    <TextBlock Text="Недвижимость.РФ" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,24" />

                    <!-- Заголовок -->
                    <TextBlock Text="Регистрация" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <TextBlock Text="Создайте аккаунт для использования платформы" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,24" TextWrapping="Wrap" />

                    <!-- Сообщение об ошибке -->
                    <Border x:Name="ErrorBorder" Background="#FEF2F2" CornerRadius="8"
                            Padding="12,8" Margin="0,0,0,16" Visibility="Collapsed">
                        <TextBlock x:Name="ErrorText" Foreground="#DC2626" FontSize="13"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Имя и Фамилия -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Имя" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="FirstNameBox" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Фамилия" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="LastNameBox" Style="{StaticResource ModernTextBox}" />
                        </StackPanel>
                    </Grid>

                    <!-- Email -->
                    <TextBlock Text="Email *" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="EmailBox" Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,16" />

                    <!-- Телефон -->
                    <TextBlock Text="Телефон" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="PhoneBox" Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,16" />

                    <!-- Пароль -->
                    <TextBlock Text="Пароль *" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBox}"
                                 Margin="0,0,0,16" />

                    <!-- Подтверждение пароля -->
                    <TextBlock Text="Подтвердите пароль *" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource ModernPasswordBox}"
                                 Margin="0,0,0,24" />

                    <!-- Кнопка регистрации -->
                    <Button x:Name="RegisterButton" Content="Зарегистрироваться"
                            Style="{StaticResource PrimaryButton}"
                            Click="RegisterButton_Click"
                            HorizontalAlignment="Stretch" />

                    <!-- Ссылка на вход -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <TextBlock Text="Уже есть аккаунт? " FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="LoginLink" Text="Войти" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}" Cursor="Hand"
                                   TextDecorations="Underline" FontWeight="SemiBold"
                                   MouseLeftButtonUp="LoginLink_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
