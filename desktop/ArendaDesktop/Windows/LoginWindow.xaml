<Window x:Class="ArendaDesktop.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Недвижимость.РФ — Вход"
        Width="480" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Border Background="White" CornerRadius="16" Padding="40"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="400">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.08" Color="Black" />
            </Border.Effect>
            <StackPanel>
                <!-- Логотип -->
                <TextBlock Text="Недвижимость.РФ" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,24" />

                <!-- Заголовок -->
                <TextBlock Text="Вход в систему" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,4" />
                <TextBlock Text="Введите свои данные для входа" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,24" />

                <!-- Сообщение об ошибке -->
                <Border x:Name="ErrorBorder" Background="#FEF2F2" CornerRadius="8"
                        Padding="12,8" Margin="0,0,0,16" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="#DC2626" FontSize="13"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Email -->
                <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="EmailBox" Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,16" />

                <!-- Пароль -->
                <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBox}"
                             Margin="0,0,0,24" />

                <!-- Кнопка входа -->
                <Button x:Name="LoginButton" Content="Войти"
                        Style="{StaticResource PrimaryButton}"
                        Click="LoginButton_Click"
                        HorizontalAlignment="Stretch" />

                <!-- Ссылка на регистрацию -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <TextBlock Text="Нет аккаунта? " FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="RegisterLink" Text="Зарегистрироваться" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" Cursor="Hand"
                               TextDecorations="Underline" FontWeight="SemiBold"
                               MouseLeftButtonUp="RegisterLink_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
